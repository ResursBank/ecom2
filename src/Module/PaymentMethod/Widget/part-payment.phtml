<?php

if ($this->iframeUrl !== '') : ?>
  <div class="rb-pp">
    <!-- Logo -->
    <div id="rb-pp-logo-container"><?= $this->logo ?></div>
      <?php

if ($this->displayInfoText) : ?>
        <!-- Pay in installments -->
        <div id="rb-pp-info"><p><?= $this->infoText ?></p></div>
      <?php endif; ?>
    <!-- Example line here -->
    <div id="rb-pp-example"><p><?= $this->startingAt ?></p></div>
    <!-- Error message -->
    <div id="rb-pp-error" class="rb-pp-hidden" style="display:none;"><p class="rb-pp-error"><?= $this->error ?></p>
    </div>

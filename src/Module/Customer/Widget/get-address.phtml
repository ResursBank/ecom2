declare(strict_types=1);

use Resursbank\Ecom\Lib\Locale\Translator;
use Resursbank\Ecom\Lib\Order\CustomerType;

/** @var Resursbank\Ecom\Module\Customer\Widget\GetAddress $this */

// If no selectable customer types are configured, default to both NATURAL and LEGAL
$selectableCustomerTypes = $this->selectableCustomerTypes ?? [CustomerType::NATURAL, CustomerType::LEGAL];

// Determine if we should hide the radio buttons (if only one customer type is available)
$hideRadioButtons = count($selectableCustomerTypes) === 1;

?>

<div id="rb-ga-widget">
    <div id="rb-ga-ct-area" <?= $hideRadioButtons ? 'style="display:none;"' : '' ?>>
        <label for="rb-ga-ct-natural">
            <input
                type="radio"
                id="rb-ga-ct-natural"
                name="rb-ga-ct"
                value="<?= CustomerType::NATURAL->name ?>"
                <?php if ($this->customerType === CustomerType::NATURAL || ($hideRadioButtons && $selectableCustomerTypes[0] === CustomerType::NATURAL)): ?>
                    checked
                <?php endif; ?>
            />
            <span>
                <?= Translator::translate(phraseId: 'customer-type-natural') ?>
            </span>
        </label>
        <label for="rb-ga-ct-legal">
            <input
                type="radio"
                id="rb-ga-ct-legal"
                name="rb-ga-ct"
                value="<?= CustomerType::LEGAL->name ?>"
            <?php if ($this->customerType === CustomerType::LEGAL || ($hideRadioButtons && $selectableCustomerTypes[0] === CustomerType::LEGAL)): ?>
                checked
            <?php endif; ?>
            />
            <span>
                <?= Translator::translate(phraseId: 'customer-type-legal') ?>
            </span>
        </label>
    </div>
    <div class="rb-ga-ssn-area">
        <input type="text" id="rb-ga-gov-id" value="<?= $this->govId ?>"/>
        <button type="button" id="rb-ga-btn">
            <span><?= Translator::translate(phraseId: 'fetch-address') ?></span>
            <span class="rb-ga-fetch-icon">
                <span class="rb-ga-fetch-icon-shard"></span>
                <span class="rb-ga-fetch-icon-shard"></span>
                <span class="rb-ga-fetch-icon-shard"></span>
            </span>
        </button>
    </div>
    <div id="rb-ga-error"></div>
</div>

declare(strict_types=1);

/** @var Html $this */

use Resursbank\Ecom\Lib\Locale\Translator;
use Resursbank\Ecom\Module\Widget\SupportInfo\Html;

?>

<div class="rb-si">
    <table>
        <tbody>
        <tr>
            <td><?= Translator::translate(phraseId: 'plugin-version') ?></td>
            <td><?= $this->pluginVersion ?></td>
        </tr>
        <tr>
            <td><?= Translator::translate(phraseId: 'php-version') ?></td>
            <td<?= $this->hasPhpVersionErrors() ? ' class="error"' : '' ?>>
                <?= $this->getPhpVersion() ?>
                <?php if ($this->hasPhpVersionErrors()): ?>
                    <span class="si-error">
                    <?= $this->validatePhpVersion() ?>
                    </span>
                <?php endif; ?>
            </td>
        </tr>
        <tr>
            <td><?= Translator::translate(phraseId: 'ecom-version') ?></td>
            <td><?= $this->getEcomVersion() ?></td>
        </tr>
        <tr>
            <td><?= Translator::translate(phraseId: 'ssl-version') ?></td>
            <td><?= $this->getSslVersion() ?></td>
        </tr>
        <tr>
            <td><?= Translator::translate(phraseId: 'curl-version') ?></td>
            <td<?= $this->hasCurlErrors() ? ' class="error"' : '' ?>>
                <?= $this->getCurlVersion() ?>
                <?php if ($this->hasCurlErrors()): ?>
                    <span class="si-error">
                    <?php foreach ($this->validateCurl() as $error): ?>
                        <?php if ($error !== null): ?>
                        <?= $error ?><br />
                        <?php endif; ?>
                    <?php endforeach; ?>
                    </span>
                <?php endif; ?>
            </td>
        </tr>
        <?php if ($this->getTemplateOverrideLocation() !== ''): ?>
        <tr>
            <td><?= Translator::translate(phraseId: 'template-override-location') ?></td>
            <td><?= $this->getTemplateOverrideLocation() ?></td>
        </tr>
        <?php endif; ?>
        <tr>
            <td><?= Translator::translate(phraseId: 'log-directory-writeable') ?></td>
            <td<?= $this->hasLogDirectoryError() ? ' class="error"' : '' ?>>
                <?= $this->getLogDirectoryError() ?>
            </td>
        </tr>
        </tbody>
    </table>
</div>

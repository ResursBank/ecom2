<?xml version="1.0"?>
<ruleset name="EcomPHP Source"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0
                     http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="
                     http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        Ecom PHPMD Ruleset applying to src files.
    </description>

    <rule ref="rulesets/codesize.xml">
    </rule>
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess" />
    </rule>
    <rule ref="rulesets/controversial.xml">
    </rule>
    <rule ref="rulesets/design.xml">
        <exclude name="CouplingBetweenObjects" />
    </rule>
    <rule ref="rulesets/naming.xml">
        <!-- Exclude rules in order to re-introduce them with specific config. -->
        <exclude name="ShortVariable" />
        <exclude name="LongVariable" />
    </rule>
    <rule ref="rulesets/unusedcode.xml" />

    <!-- Re-introduce rule with specific config. -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="exceptions" value="id,ch,ip,en,sv,da,fi,no,js"/>
        </properties>
    </rule>

    <!-- Re-introduce rule with specific config. -->
    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <property name="subtract-prefixes" value="paymentHistory"/>
        </properties>
    </rule>

    <exclude-pattern>Lib/Model/Rco/Enum/ShippingSelection.php</exclude-pattern>
    <exclude-pattern>Lib/Model/Rco/Enum/PaymentSelection.php</exclude-pattern>
    <exclude-pattern>Lib/Order/CountryCode.php</exclude-pattern>
    <exclude-pattern>Lib/Network/ContentType.php</exclude-pattern>
    <exclude-pattern>Lib/Model/PaymentMethod/ApplicationFormSpecResponse/ApplicationFormSpecElementResponse/Type.php</exclude-pattern>
    <exclude-pattern>Lib/Utilities/Random/DataType.php</exclude-pattern>
</ruleset>
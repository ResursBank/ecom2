<?xml version="1.0"?>
<psalm
    cacheDirectory="psalm-cache">
    <projectFiles>
        <directory name="../src" />
        <directory name="../tests" />
    </projectFiles>
    <issueHandlers>
        <PropertyNotSetInConstructor errorLevel="suppress" />
        <MixedPropertyFetch>
            <errorLevel type="suppress">
                <directory name="./" />
            </errorLevel>
        </MixedPropertyFetch>
        <InvalidNullableReturnType>
            <errorLevel type="suppress">
                <file name="../src/Config.php" />
            </errorLevel>
        </InvalidNullableReturnType>
        <PossiblyNullPropertyFetch>
            <errorLevel type="suppress">
                <file name="../src/Config.php" />
            </errorLevel>
        </PossiblyNullPropertyFetch>
        <NullableReturnStatement>
            <errorLevel type="suppress">
                <file name="../src/Config.php" />
            </errorLevel>
        </NullableReturnStatement>
        <MixedAssignment>
            <errorLevel type="suppress">
                <file name="../src/Lib/Model/Model.php" />
            </errorLevel>
        </MixedAssignment>
    </issueHandlers>
</psalm>

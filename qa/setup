#!/bin/sh -e

if [ ! -d .git/hooks ]; then
  echo "Error: Please run this script from the root of the repository."
  exit 1;
fi

read -p "Enter name of docker-compose php service: " service
read -p "Enter path to website root directory within PHP container (no trailing slash): " dir

HOOK_FILE=".git/hooks/pre-commit"

if [ -f $HOOK_FILE ]; then
  rm -f $HOOK_FILE
fi

touch $HOOK_FILE
chmod +x $HOOK_FILE

cat <<EOT >> $HOOK_FILE
#!/bin/sh -e

docker-compose exec -T $service psalm -c $dir/qa/psalm/psalm.xml --show-info=true
docker-compose exec -T $service phpmd $dir/src text $dir/qa/phpmd/src.xml
docker-compose exec -T $service phpmd $dir/tests text $dir/qa/phpmd/tests.xml
EOT

if [ ! -d ./qa/psalm/cache ]; then
  mkdir ./qa/psalm/cache
fi

echo OK
exit 0
